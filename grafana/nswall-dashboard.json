          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Packets" },
            "properties": [{ "id": "custom.displayMode", "value": "gradient-gauge" }]
          },
          {
            "matcher": { "id": "byName", "options": "Bytes" },
            "properties": [{ "id": "unit", "value": "decbytes" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
