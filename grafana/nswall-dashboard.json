          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top Rules by Packets",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "renameByName": {
              "Value": "Packets",
              "action": "Action",
              "direction": "Direction",
              "interface": "Interface",
              "rule": "Rule #"
            }
          }
        }
      ],
      "type": "table"
    },
